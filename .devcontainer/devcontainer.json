{
  "name": "Cinematic Portrait",
  "image": "mcr.microsoft.com/devcontainers/python:3.11",
  "postCreateCommand": "pip install -r requirements.txt pytest",
  "forwardPorts": [5000],
  "portsAttributes": {
    "5000": { "label": "Cinematic Portrait app", "onAutoForward": "openBrowser" }
  },
  "customizations": {
    "codespaces": { "openFiles": ["README.md"] }
  }
}
